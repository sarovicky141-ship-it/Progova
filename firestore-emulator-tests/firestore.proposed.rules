rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isStudent() {
      return hasRole('student');
    }

    function isAppUser() {
      return isAdmin() || isStudent();
    }

    function studentProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    match /users/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /students/{studentId} {
      allow get, list: if isAdmin()
        || (isStudent() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow get, list: if isAdmin()
        || (isStudent() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /feedbacks/{feedbackId} {
      allow get, list: if isAdmin()
        || (isStudent() && resource.data.uid == request.auth.uid);

      allow create: if isAdmin()
        || (isStudent()
          && request.resource.data.keys().hasAll([
            'id',
            'type',
            'subject',
            'rating',
            'message',
            'uid',
            'studentId',
            'date',
            'status',
            'response'
          ])
          && request.resource.data.keys().hasOnly([
            'id',
            'type',
            'subject',
            'rating',
            'message',
            'uid',
            'studentId',
            'date',
            'status',
            'response'
          ])
          && request.resource.data.id == feedbackId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.studentId == studentProfile().studentId
          && request.resource.data.status == 'New'
          && request.resource.data.response == null);

      allow update, delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isAppUser();
      allow create, update, delete: if isAdmin();
    }

    match /placements/{placementId} {
      allow read: if isAppUser();
      allow create, update, delete: if isAdmin();

      match /applications/{uid} {
        allow get, list: if isAdmin()
          || (isStudent()
            && request.auth.uid == uid
            && resource.data.uid == request.auth.uid);

        allow create, update, delete: if isAdmin();
      }
    }

    match /messages/{messageId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /metadata/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
